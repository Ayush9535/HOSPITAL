SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# JWT Secret
JWT_SECRET=

# CORS — allow local frontend
FRONTEND_URL=http://localhost:5173

# Server port
PORT=8080

# Redis — local Docker
SPRING_REDIS_HOST=localhost
SPRING_REDIS_PORT=6379

# Private directory for patient clinical documents (blood reports, scans, photographed
# prescriptions). Must be on persistent storage and NOT inside the web server's document root.
# Example for a VPS deployment: /var/lib/hms/patient-documents
HMS_DOCUMENT_STORAGE_PATH=
